# ============================================================
# Blockchain Sustainability Project — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to version control.

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blockchain_sustainability
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Coin Metrics API ─────────────────────────────────────────
# Free-tier key available at: https://coinmetrics.io/api/
# Free Community API key gives access to most metrics.
# Sign up at: https://coinmetrics.io/api-v4/
COINMETRICS_API_KEY=your_coinmetrics_key_here

# ─── Etherscan API ────────────────────────────────────────────
# Free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_key_here

# ─── Blockchain.com API ───────────────────────────────────────
# No key required for public chart API.
# This is left blank intentionally.
BLOCKCHAIN_COM_API_KEY=

# ─── Glassnode API ────────────────────────────────────────────
# Free-tier available at: https://glassnode.com/
# Free accounts have limited historical access.
GLASSNODE_API_KEY=your_glassnode_key_here

# ─── Application Configuration ────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ─── Date Ranges ──────────────────────────────────────────────
# Start date for data collection (Ethereum genesis: 2015-07-30)
ETH_START_DATE=2017-01-01
BTC_START_DATE=2017-01-01
# Ethereum Merge date (PoW → PoS transition)
ETH_MERGE_DATE=2022-09-15

# ─── Rate Limiting ────────────────────────────────────────────
# Seconds to wait between API requests (be respectful to APIs)
API_RATE_LIMIT_SECONDS=0.5
API_MAX_RETRIES=3
API_RETRY_DELAY_SECONDS=2
